{
    "platform": {
      "name": "BaaS - Banking as a Service",
      "version": "1.0.0",
      "description": "Modern banking platform with comprehensive customer, employee, and authentication management"
    },
    "theme": {
      "primary": {
        "colors": {
          "brand": "#3B82F6",
          "brandHover": "#2563EB",
          "brandLight": "#DBEAFE",
          "brandDark": "#1D4ED8"
        }
      },
      "semantic": {
        "colors": {
          "success": "#10B981",
          "successLight": "#D1FAE5",
          "warning": "#F59E0B",
          "warningLight": "#FEF3C7",
          "error": "#EF4444",
          "errorLight": "#FEE2E2",
          "info": "#3B82F6",
          "infoLight": "#DBEAFE"
        }
      },
      "neutral": {
        "colors": {
          "slate50": "#F8FAFC",
          "slate100": "#F1F5F9",
          "slate200": "#E2E8F0",
          "slate300": "#CBD5E1",
          "slate400": "#94A3B8",
          "slate500": "#64748B",
          "slate600": "#475569",
          "slate700": "#334155",
          "slate800": "#1E293B",
          "slate900": "#0F172A"
        }
      },
      "background": {
        "gradients": {
          "primary": "bg-gradient-to-b from-slate-50 to-slate-100",
          "card": "bg-white",
          "sidebar": "bg-slate-900",
          "header": "bg-white"
        }
      }
    },
    "typography": {
      "fonts": {
        "primary": "Geist",
        "mono": "GeistMono",
        "fallback": "system-ui, sans-serif"
      },
      "scales": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem"
      },
      "weights": {
        "normal": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      }
    },
    "spacing": {
      "scale": {
        "xs": "0.25rem",
        "sm": "0.5rem",
        "base": "1rem",
        "lg": "1.5rem",
        "xl": "2rem",
        "2xl": "3rem",
        "3xl": "4rem"
      },
      "layout": {
        "sidebar": "256px",
        "header": "64px",
        "containerMax": "1280px",
        "contentPadding": "24px"
      }
    },
    "components": {
      "buttons": {
        "variants": {
          "primary": {
            "background": "bg-blue-600",
            "hover": "hover:bg-blue-700",
            "text": "text-white",
            "padding": "px-4 py-2",
            "radius": "rounded-md",
            "transition": "transition-colors duration-200"
          },
          "secondary": {
            "background": "bg-slate-100",
            "hover": "hover:bg-slate-200",
            "text": "text-slate-900",
            "padding": "px-4 py-2",
            "radius": "rounded-md",
            "transition": "transition-colors duration-200"
          },
          "outline": {
            "background": "bg-transparent",
            "border": "border border-slate-300",
            "hover": "hover:bg-slate-50",
            "text": "text-slate-700",
            "padding": "px-4 py-2",
            "radius": "rounded-md",
            "transition": "transition-colors duration-200"
          }
        },
        "sizes": {
          "sm": "px-3 py-1.5 text-sm",
          "md": "px-4 py-2 text-base",
          "lg": "px-6 py-3 text-lg"
        }
      },
      "cards": {
        "base": {
          "background": "bg-white",
          "shadow": "shadow-lg",
          "radius": "rounded-2xl",
          "border": "border border-slate-200",
          "padding": "p-6"
        },
        "hover": {
          "shadow": "hover:shadow-xl",
          "transition": "transition-shadow duration-300"
        }
      },
      "forms": {
        "input": {
          "base": "w-full px-3 py-2 border border-slate-300 rounded-md",
          "focus": "focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
          "error": "border-red-500 focus:ring-red-500 focus:border-red-500",
          "disabled": "disabled:bg-slate-100 disabled:text-slate-500"
        },
        "label": {
          "base": "block text-sm font-medium text-slate-700 mb-1"
        },
        "error": {
          "text": "text-red-600 text-sm mt-1"
        }
      },
      "tables": {
        "container": {
          "background": "bg-white",
          "radius": "rounded-lg",
          "shadow": "shadow"
        },
        "header": {
          "background": "bg-slate-50",
          "text": "text-slate-900 font-medium",
          "padding": "px-6 py-3"
        },
        "cell": {
          "padding": "px-6 py-4",
          "border": "border-b border-slate-200"
        }
      },
      "badges": {
        "variants": {
          "success": {
            "background": "bg-green-100",
            "text": "text-green-800",
            "hover": "hover:bg-green-100"
          },
          "warning": {
            "background": "bg-yellow-100",
            "text": "text-yellow-800",
            "hover": "hover:bg-yellow-100"
          },
          "error": {
            "background": "bg-red-100",
            "text": "text-red-800",
            "hover": "hover:bg-red-100"
          },
          "info": {
            "background": "bg-blue-100",
            "text": "text-blue-800",
            "hover": "hover:bg-blue-100"
          },
          "neutral": {
            "background": "bg-slate-100",
            "text": "text-slate-800",
            "hover": "hover:bg-slate-100"
          }
        },
        "base": "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium"
      }
    },
    "layout": {
      "sidebar": {
        "width": "256px",
        "background": "bg-slate-900",
        "text": "text-white",
        "navigation": {
          "item": {
            "base": "flex items-center px-4 py-2 text-sm",
            "hover": "hover:bg-slate-800",
            "active": "bg-slate-800 border-r-2 border-blue-500"
          }
        }
      },
      "header": {
        "height": "64px",
        "background": "bg-white",
        "border": "border-b border-slate-200",
        "shadow": "shadow-sm"
      },
      "content": {
        "padding": "p-6",
        "maxWidth": "max-w-7xl",
        "margin": "mx-auto"
      }
    },
    "modules": {
      "customer": {
        "theme": {
          "primary": "#3B82F6",
          "accent": "#10B981"
        },
        "icons": {
          "primary": "UserIcon",
          "secondary": "BuildingStorefrontIcon"
        },
        "statusColors": {
          "active": "green",
          "inactive": "red",
          "pending": "yellow",
          "verified": "blue"
        }
      },
      "employee": {
        "theme": {
          "primary": "#7C3AED",
          "accent": "#F59E0B"
        },
        "icons": {
          "primary": "UserGroupIcon",
          "secondary": "ShieldCheckIcon"
        },
        "roleColors": {
          "admin": "purple",
          "manager": "blue",
          "support": "green",
          "compliance": "orange",
          "itAdmin": "indigo"
        }
      },
      "authentication": {
        "theme": {
          "primary": "#1F2937",
          "accent": "#3B82F6"
        },
        "icons": {
          "primary": "LockClosedIcon",
          "secondary": "ShieldCheckIcon"
        },
        "form": {
          "background": "bg-white",
          "shadow": "shadow-lg",
          "radius": "rounded-2xl",
          "padding": "p-8"
        }
      }
    },
    "animations": {
      "transitions": {
        "default": "transition-all duration-200 ease-in-out",
        "fast": "transition-all duration-150 ease-in-out",
        "slow": "transition-all duration-300 ease-in-out"
      },
      "hover": {
        "scale": "hover:scale-105",
        "shadow": "hover:shadow-xl",
        "opacity": "hover:opacity-80"
      },
      "loading": {
        "spinner": "animate-spin",
        "pulse": "animate-pulse",
        "bounce": "animate-bounce"
      }
    },
    "breakpoints": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px",
      "2xl": "1536px"
    },
    "accessibility": {
      "focus": {
        "ring": "focus:ring-2 focus:ring-blue-500 focus:ring-offset-2",
        "outline": "focus:outline-none"
      },
      "contrast": {
        "minimum": "4.5:1",
        "enhanced": "7:1"
      },
      "keyboard": {
        "navigation": "focus-visible:ring-2 focus-visible:ring-blue-500"
      }
    },
    "iconography": {
      "library": "Heroicons",
      "sizes": {
        "xs": "h-3 w-3",
        "sm": "h-4 w-4",
        "base": "h-5 w-5",
        "lg": "h-6 w-6",
        "xl": "h-8 w-8"
      },
      "common": {
        "dashboard": "ChartBarIcon",
        "customers": "UserIcon",
        "employees": "UserGroupIcon",
        "settings": "CogIcon",
        "reports": "ClipboardDocumentListIcon",
        "security": "ShieldCheckIcon",
        "transactions": "ArrowsRightLeftIcon",
        "alerts": "ExclamationTriangleIcon",
        "success": "CheckCircleIcon",
        "error": "XCircleIcon",
        "warning": "ExclamationTriangleIcon",
        "info": "InformationCircleIcon"
      }
    },
    "notifications": {
      "toast": {
        "position": "top-right",
        "duration": 5000,
        "variants": {
          "success": {
            "background": "bg-green-50",
            "border": "border-green-200",
            "text": "text-green-800",
            "icon": "CheckCircleIcon"
          },
          "error": {
            "background": "bg-red-50",
            "border": "border-red-200",
            "text": "text-red-800",
            "icon": "XCircleIcon"
          },
          "warning": {
            "background": "bg-yellow-50",
            "border": "border-yellow-200",
            "text": "text-yellow-800",
            "icon": "ExclamationTriangleIcon"
          },
          "info": {
            "background": "bg-blue-50",
            "border": "border-blue-200",
            "text": "text-blue-800",
            "icon": "InformationCircleIcon"
          }
        }
      }
    },
    "data": {
      "loading": {
        "skeleton": "animate-pulse bg-slate-200 rounded",
        "spinner": "animate-spin h-5 w-5 text-blue-600",
        "overlay": "bg-white bg-opacity-75 backdrop-blur-sm"
      },
      "empty": {
        "background": "bg-slate-50",
        "text": "text-slate-500",
        "icon": "h-12 w-12 text-slate-400"
      },
      "error": {
        "background": "bg-red-50",
        "border": "border-red-200",
        "text": "text-red-700",
        "icon": "h-8 w-8 text-red-500"
      }
    },
    "security": {
      "indicators": {
        "secure": {
          "color": "text-green-600",
          "background": "bg-green-50",
          "icon": "ShieldCheckIcon"
        },
        "warning": {
          "color": "text-yellow-600",
          "background": "bg-yellow-50",
          "icon": "ExclamationTriangleIcon"
        },
        "risk": {
          "color": "text-red-600",
          "background": "bg-red-50",
          "icon": "ShieldExclamationIcon"
        }
      }
    }
  } 