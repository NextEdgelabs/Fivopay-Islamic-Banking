export function useFilteredCustomers(): Customer[] {    getIntakeStats,

  const { customers, filters, sortOptions } = useCustomers();    getCaseStats,

      generateCustomerId,

  let filtered = [...customers];    generateIntakeId,

      generateCaseId,

  // Apply filters    calculateAccountBalance

  if (filters.searchQuery) {  };

    const query = filters.searchQuery.toLowerCase();

    filtered = filtered.filter(c =>   return (

      `${c.personalDetails.firstName} ${c.personalDetails.lastName}`.toLowerCase().includes(query) ||    <CustomerContext.Provider value={value}>

      c.customerNumber.toLowerCase().includes(query) ||      {children}

      c.contactDetails.primaryEmail.toLowerCase().includes(query)    </CustomerContext.Provider>

    );  );

  }}; 
  
  if (filters.status?.length) {
    filtered = filtered.filter(c => filters.status!.includes(c.status));
  }
  
  if (filters.kycStatus?.length) {
    filtered = filtered.filter(c => filters.kycStatus!.includes(c.compliance.kycStatus));
  }
  
  if (filters.bankingMode?.length) {
    filtered = filtered.filter(c => filters.bankingMode!.includes(c.bankingMode));
  }
  
  // Apply sorting
  filtered.sort((a, b) => {
    let aVal: any, bVal: any;
    
    switch (sortOptions.field) {
      case 'name':
        aVal = `${a.personalDetails.firstName} ${a.personalDetails.lastName}`;
        bVal = `${b.personalDetails.firstName} ${b.personalDetails.lastName}`;
        break;
      case 'customerNumber':
        aVal = a.customerNumber;
        bVal = b.customerNumber;
        break;
      case 'createdDate':
        aVal = new Date(a.createdDate).getTime();
        bVal = new Date(b.createdDate).getTime();
        break;
      case 'totalBalance':
        aVal = a.accounts[0]?.currentBalance || 0;
        bVal = b.accounts[0]?.currentBalance || 0;
        break;
      default:
        aVal = a.createdDate;
        bVal = b.createdDate;
    }
    
    if (aVal < bVal) return sortOptions.direction === 'asc' ? -1 : 1;
    if (aVal > bVal) return sortOptions.direction === 'asc' ? 1 : -1;
    return 0;
  });
  
  return filtered;
}